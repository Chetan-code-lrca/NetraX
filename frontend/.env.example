# Public URL of the deployed NetraX FastAPI backend.
# Required in production builds (Vercel) - the app never falls back to
# localhost when this is unset in a production build.
# In development (`npm run dev`) this can be left unset; the app defaults
# to http://<current-host>:8000.
VITE_NETRAX_API_URL=https://your-netrax-api.example.com
