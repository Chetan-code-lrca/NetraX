# Local dashboard binding. Keep loopback unless remote/LAN access is intentional.
NETRAX_BIND_ADDRESS=127.0.0.1
NETRAX_PORT=8080

# Maximum analyses running concurrently in the API process (default: 2).
NETRAX_MAX_CONCURRENT_ANALYSES=2

# Optional. Directory containing trusted NetraX .joblib model artifacts.
NETRAX_MODEL_DIR=./model-artifacts

# Optional. Override the CICFlowMeter executable path.
# NETRAX_CICFLOWMETER_PATH=/absolute/path/to/cicflowmeter

# Comma-separated frontend origins for separate frontend/API deployments.
# Do not use a wildcard for production.
# NETRAX_ALLOWED_ORIGINS=https://your-dashboard.example.com
